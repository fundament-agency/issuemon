{
  "name": "issuemon",
  "productName": "IssueMon",
  "version": "0.5.0",
  "description": "Keep an eye on Jira issues and see right away what changed.",
  "private": true,
  "license": "MIT",
  "author": "Fundament (https://www.fundament.agency/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fundament-agency/issuemon.git"
  },
  "homepage": "https://github.com/fundament-agency/issuemon#readme",
  "bugs": {
    "url": "https://github.com/fundament-agency/issuemon/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "mock-jira": "node test/support/mock-jira.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/**/*.e2e.js\"",
    "fuzz": "node fuzz/run.js",
    "preversion": "npm test",
    "icons": "electron scripts/make-icons.js",
    "pack": "install-electron && electron-builder --dir",
    "dist": "install-electron && electron-builder"
  },
  "build": {
    "appId": "agency.fundament.issuemon",
    "productName": "IssueMon",
    "copyright": "Copyright © 2026 Fundament",
    "electronLanguages": [
      "en",
      "en_GB",
      "nl",
      "fr",
      "de",
      "es",
      "es_419"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "artifactBuildCompleted": "scripts/artifact-build-completed.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Keep an eye on Jira issues",
      "electronLanguages": [
        "en-US",
        "en-GB",
        "nl",
        "fr",
        "de",
        "es",
        "es-419"
      ],
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fundament-agency",
        "repo": "issuemon",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  }
}
